# Local development template (never use these sample DB credentials in production).
# Copy to backend/.env and supply your own Sui testnet and Billplz sandbox credentials.
DB_HOST=localhost
DB_PORT=5433
DB_USER=root
DB_PASSWORD=secretpassword
DB_NAME=swapngo

JWT_SECRET=CHANGE_ME_long_random_secret
KYC_ENCRYPTION_KEY=CHANGE_ME_strong_encryption_key
JWT_ACCESS_TIME=168h
JWT_REFRESH_TIME=24h
KAFKA_BROKERS=localhost:9092

BILLPLZ_API_URL=https://www.billplz-sandbox.com/api/v3
BILLPLZ_API_KEY=CHANGE_ME_sandbox_key
BILLPLZ_COLLECTION_ID=CHANGE_ME_sandbox_collection
# Billplz callbacks require a publicly reachable HTTPS endpoint.
BILLPLZ_CALLBACK_URL=https://your-test-domain.example/api/v1/public/deposit/webhook
BILLPLZ_REDIRECT_URL=swapngo://deposit/status

SUI_CHAIN_URL=https://fullnode.testnet.sui.io:443
SOL_CHAIN_URL=https://api.testnet.solana.com
EVM_CHAIN_URL=https://rpc.ankr.com/eth_sepolia
SUI_TREASURY_ADDRESS=CHANGE_ME_testnet_address
SUI_TREASURY_PRIVATE_KEY=CHANGE_ME_private_key
MYRC_SUI_PACKAGE_ID=CHANGE_ME_package_id
MYRC_SUI_TREASURY_CAP_ID=CHANGE_ME_treasury_cap_id
SUI_ADMIN_ADDRESS=CHANGE_ME_admin_address
SUI_ADMIN_PRIVATE_KEY=CHANGE_ME_admin_key
